{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abc-supply:internal:handoff:0.1.0",
  "title": "Proposed Internal API Handoff",
  "description": "Internal control-plane envelope, not the ABC wire request. Server must verify all references and resource bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "handoffId",
    "workflowId",
    "operationId",
    "context",
    "request",
    "deadlineAt",
    "evidenceRefs"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "handoffId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "enum": [
        "place_orders",
        "get_order_by_number",
        "get_order_by_confirmation",
        "get_order_history",
        "get_order_templates",
        "get_order_template",
        "price_items",
        "search_accounts",
        "get_sold_to",
        "get_bill_to",
        "get_ship_to",
        "get_ship_to_contacts",
        "get_item",
        "get_all_items",
        "get_favorite_items",
        "get_recent_items",
        "get_frequent_items",
        "add_favorite_item",
        "search_items",
        "search_item_availability",
        "get_item_availability",
        "get_product_hierarchy",
        "get_item_image",
        "search_branches",
        "get_branch",
        "register_webhook",
        "get_webhook",
        "get_webhooks",
        "update_webhook",
        "unregister_webhook",
        "get_invoice_history",
        "get_invoice",
        "get_invoice_pdf"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "principalId",
        "connectionId",
        "integrationTrack",
        "environment",
        "credentialRef"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "integrationTrack": {
          "enum": [
            "individual_business",
            "third_party_aggregator"
          ]
        },
        "environment": {
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "credentialRef": {
          "type": "string",
          "minLength": 1
        },
        "accountBindingRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "query",
        "body"
      ],
      "properties": {
        "path": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "query": {
          "type": "object"
        },
        "body": {
          "type": [
            "object",
            "array",
            "null"
          ]
        }
      }
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commandKey": {
      "type": "string",
      "minLength": 1
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorizationDecisionRef": {
      "type": "string",
      "minLength": 1
    },
    "approvalRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operationId": {
            "enum": [
              "place_orders",
              "add_favorite_item",
              "register_webhook",
              "update_webhook",
              "unregister_webhook"
            ]
          }
        }
      },
      "then": {
        "required": [
          "commandKey",
          "payloadSha256",
          "authorizationDecisionRef"
        ]
      }
    }
  ],
  "x-runtime-invariants": [
    "credentialRef is an opaque server reference, never an access token; reject credentials in model-authored arguments",
    "path/query/body must validate against the selected adapter profile; arbitrary extra upstream parameters are forbidden by adapter allowlists",
    "resource IDs must resolve to the same tenant, principal, integration connection and environment; cross-check account/branch ownership",
    "operation_id is allowlisted; URL/hostname cannot be selected by an agent argument",
    "hash covers canonical operationId, trusted context bindings and exact wire request; commandKey uniqueness is enforced atomically per tenant/connection/environment",
    "approvalRef, when policy requires it, must bind approver, exact payload hash, tenant, environment and expiry; never trust a model assertion of approval",
    "request.body null for bodyless endpoints; array for place_orders; object for other documented JSON-body endpoints"
  ]
}

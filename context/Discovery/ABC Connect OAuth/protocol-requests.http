# Templates only. Resolve credentials server-side; do not execute as-is.
# Generic OAuth fields follow RFC 6749 / PKCE; ABC-specific endpoint examples use Basic client auth.

# 1. Browser redirect for a TPA API connection (URL-encode each parameter)
GET {{abc_authorization_endpoint}}?client_id={{abc_client_id}}&response_type=code&redirect_uri={{registered_broker_callback}}&state={{single_use_state}}&code_challenge={{base64url_sha256_verifier}}&code_challenge_method=S256&scope=account.read%20product.read%20pricing.read%20order.read%20order.write%20offline_access

###
# 2. Server-side code redemption; use the client's actual registered authentication method.
POST {{abc_token_endpoint}}
Authorization: Basic <SERVER_RESOLVED_ENCODED_CLIENT_CREDENTIALS>
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&redirect_uri={{registered_broker_callback}}&code={{authorization_code}}&code_verifier={{server_held_verifier}}

###
# 3. Server-side refresh; scopes may not exceed the approved grant.
POST {{abc_token_endpoint}}
Authorization: Basic <SERVER_RESOLVED_ENCODED_CLIENT_CREDENTIALS>
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&refresh_token={{server_held_refresh_token}}

###
# 4. TPA platform-only example. Client credentials has no user refresh token.
POST {{abc_token_endpoint}}
Authorization: Basic <SERVER_RESOLVED_ENCODED_CLIENT_CREDENTIALS>
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&scope=location.read%20product.read

###
# 5. Correct bodyless supplier API example.
GET {{abc_api_base}}/api/location/v1/branches/{{allowed_branch_number}}
Authorization: Bearer <SERVER_RESOLVED_ABC_ACCESS_TOKEN>

# Optional ABC-to-Entra OIDC federation uses a separately approved client/profile.
# It requires openid; Entra response_type code and compatible client_secret_post or client_secret_jwt.
# Do not add identity scopes to an API client until ABC confirms them for that registration.

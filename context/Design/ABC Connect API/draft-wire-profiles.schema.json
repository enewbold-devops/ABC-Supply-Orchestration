{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abc-supply:internal:wire-profile:0.1.0",
  "title": "Draft Local Wire Validation Profiles",
  "description": "Local allowlisted subset from public documentation; not official schemas. Required fields without provider asterisks are local choices. Sandbox validation required.",
  "$defs": {
    "place_orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "purchaseOrder": {
            "type": "string",
            "maxLength": 16
          },
          "branchNumber": {
            "type": "string"
          },
          "deliveryService": {
            "type": "string"
          },
          "typeCode": {
            "const": "SO"
          },
          "dates": {
            "type": "object",
            "properties": {
              "deliveryRequestedFor": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "deliveryAppointment": {
            "type": "object",
            "properties": {
              "instructionsTypeCode": {
                "enum": [
                  "AT",
                  "AM",
                  "PM",
                  "FS",
                  "ST",
                  "TR"
                ]
              },
              "instructions": {
                "type": "string",
                "maxLength": 255
              },
              "fromTime": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "toTime": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "required": [
              "instructionsTypeCode",
              "instructions",
              "fromTime",
              "toTime"
            ],
            "additionalProperties": false
          },
          "currency": {
            "type": "string"
          },
          "shipTo": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "address": {
                "type": "object",
                "properties": {
                  "line1": {
                    "type": "string"
                  },
                  "line2": {
                    "type": "string"
                  },
                  "line3": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "postal": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  }
                },
                "required": [
                  "line1",
                  "line2",
                  "line3",
                  "city",
                  "state",
                  "postal",
                  "country"
                ],
                "additionalProperties": false
              },
              "contacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "functionCode": {
                      "enum": [
                        "SM",
                        "DC"
                      ]
                    },
                    "email": {
                      "type": "string"
                    },
                    "phones": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "number": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "ext": {
                            "type": "string"
                          }
                        },
                        "required": [],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "number",
              "address",
              "contacts"
            ],
            "additionalProperties": false
          },
          "orderComments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 99,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "itemNumber": {
                  "type": "string"
                },
                "itemDescription": {
                  "type": "string"
                },
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "length": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "uom": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "value",
                        "uom"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "length"
                  ],
                  "additionalProperties": false
                },
                "orderedQty": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "uom": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "uom"
                  ],
                  "additionalProperties": false
                },
                "unitPrice": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "uom": {
                      "type": "string"
                    },
                    "instructions": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "uom",
                    "instructions"
                  ],
                  "additionalProperties": false
                },
                "comments": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "itemNumber",
                "itemDescription",
                "orderedQty",
                "unitPrice"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "requestId",
          "purchaseOrder",
          "branchNumber",
          "deliveryService",
          "typeCode",
          "currency",
          "shipTo",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "price_items": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "shipToNumber": {
          "type": "string"
        },
        "branchNumber": {
          "type": "string"
        },
        "purpose": {
          "enum": [
            "estimating",
            "quoting",
            "ordering"
          ]
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "itemNumber": {
                "type": "string"
              },
              "quantity": {
                "type": "integer"
              },
              "uom": {
                "type": "string"
              },
              "length": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "uom": {
                    "type": "string"
                  }
                },
                "required": [
                  "value",
                  "uom"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "itemNumber",
              "quantity",
              "uom"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "requestId",
        "shipToNumber",
        "branchNumber",
        "purpose",
        "lines"
      ],
      "additionalProperties": false
    },
    "register_webhook": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "const": "ORDER"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ORDER_UPDATE",
              "ORDER_INVOICED"
            ]
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "type",
        "events",
        "url"
      ],
      "additionalProperties": false
    },
    "update_webhook": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "const": "ORDER"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "ORDER_UPDATE"
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "type",
        "events",
        "url"
      ],
      "additionalProperties": false
    }
  },
  "x-design-choices": [
    "One order per request is a local default, not a provider batch limit.",
    "Positive nonempty arrays, complete webhook fields, explicit pricing UOM and required pricing request context are local validation choices.",
    "country is a string per example despite the provider table conflict.",
    "Dynamic item dimensionality, supported UOM/length, exact valid local times and branch delivery service must be checked by runtime rules.",
    "PATCH support is restricted to ORDER_UPDATE in this draft.",
    "Other endpoint parameter declarations are in upstream-operation-catalog.json; no complete provider requiredness is invented."
  ]
}
